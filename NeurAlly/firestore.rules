rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Perfil do usuário + subcoleções (diario, anotacoes, triagem)
    match /usuarios/{uid} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create, update, delete: if request.auth != null && request.auth.uid == uid;

      match /{subcolecao}/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Diretório público de psicólogos (só nome e CRP; usado na busca de profissionais).
    // CPF, telefone etc. continuam apenas em usuarios/{uid}.
    match /psicologos/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid;
    }

    // Consultas: o cliente que marcou e o psicólogo escolhido conseguem ler.
    match /consultas/{consultaId} {
      allow create: if request.auth != null
        && request.resource.data.clienteId == request.auth.uid;
      allow read: if request.auth != null
        && (resource.data.clienteId == request.auth.uid
            || resource.data.profissionalId == request.auth.uid);
    }

    // Reservas de horário (1 por bloco de 30 min). Só podem ser criadas, nunca alteradas:
    // se o bloco já existe, a gravação é recusada e ninguém marca o mesmo horário duas vezes.
    match /reservas/{reservaId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.clienteId == request.auth.uid;
    }

    // Conversas
    match /chats/{chatId} {
      // Conversas de demonstração (ids que começam com chat_teste)
      allow read, write: if request.auth != null && chatId.matches('chat_teste.*');

      // Conversas reais: só os dois participantes
      allow get: if request.auth != null
        && (resource == null || request.auth.uid in resource.data.participantes);
      allow list: if request.auth != null
        && request.auth.uid in resource.data.participantes;
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.participantes;
      allow update: if request.auth != null
        && request.auth.uid in resource.data.participantes;

      match /mensagens/{mensagemId} {
        allow read, write: if request.auth != null && chatId.matches('chat_teste.*');

        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantes;
        allow create: if request.auth != null
          && request.resource.data.remetenteId == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantes;
      }
    }
  }
}
