rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Perfil do usuário + subcoleções (diario, anotacoes, triagem)
    match /usuarios/{uid} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create, update, delete: if request.auth != null && request.auth.uid == uid;

      match /{subcolecao}/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Diretório público de psicólogos (só nome e CRP; usado na busca de profissionais).
    // CPF, telefone etc. continuam apenas em usuarios/{uid}.
    match /psicologos/{uid} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null && request.auth.uid == uid;
    }

    // Consultas: o cliente que marcou e o psicólogo escolhido conseguem ler.
    // Atualização (cancelar/reagendar) só em consultas ainda 'agendada':
    //  - o cliente pode cancelar e reagendar (data, horário e modalidade);
    //  - o psicólogo só pode cancelar.
    // Ninguém troca o cliente nem o psicólogo da consulta.
    match /consultas/{consultaId} {
      allow create: if request.auth != null
        && request.resource.data.clienteId == request.auth.uid;
      allow read: if request.auth != null
        && (resource.data.clienteId == request.auth.uid
            || resource.data.profissionalId == request.auth.uid);
      allow update: if request.auth != null
        && resource.data.status == 'agendada'
        && request.resource.data.clienteId == resource.data.clienteId
        && request.resource.data.profissionalId == resource.data.profissionalId
        && (
          (resource.data.clienteId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'canceladaPor', 'canceladaEm', 'data', 'horario', 'modalidade', 'reagendadaEm']))
          ||
          (resource.data.profissionalId == request.auth.uid
            && request.resource.data.status == 'cancelada'
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'canceladaPor', 'canceladaEm']))
        );
    }

    // Reservas de horário (1 por bloco de 30 min). Só podem ser criadas ou apagadas, nunca
    // alteradas: se o bloco já existe, a gravação é recusada e ninguém marca o mesmo horário duas
    // vezes. Quem reservou (cliente) ou o dono da agenda (psicólogo) pode liberar o bloco ao
    // cancelar ou reagendar a consulta.
    match /reservas/{reservaId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.clienteId == request.auth.uid;
      allow delete: if request.auth != null
        && (resource == null
            || resource.data.clienteId == request.auth.uid
            || resource.data.profissionalId == request.auth.uid);
    }

    // Chamadas de vídeo das consultas on-line: um documento por consulta (mesmo id da consulta).
    // O psicólogo da consulta abre e encerra a sala; ele e o paciente conseguem ler o estado
    // (se a sala está aberta e o endereço dela). Só vale para consultas ainda 'agendada'.
    match /chamadas/{consultaId} {
      allow read: if request.auth != null
        && (get(/databases/$(database)/documents/consultas/$(consultaId)).data.clienteId == request.auth.uid
            || get(/databases/$(database)/documents/consultas/$(consultaId)).data.profissionalId == request.auth.uid);
      allow create, update: if request.auth != null
        && get(/databases/$(database)/documents/consultas/$(consultaId)).data.profissionalId == request.auth.uid
        && get(/databases/$(database)/documents/consultas/$(consultaId)).data.status == 'agendada'
        && request.resource.data.profissionalId == request.auth.uid
        && request.resource.data.clienteId == get(/databases/$(database)/documents/consultas/$(consultaId)).data.clienteId;
    }

    // Conversas
    match /chats/{chatId} {
      // Conversas reais: só os dois participantes
      allow get: if request.auth != null
        && (resource == null || request.auth.uid in resource.data.participantes);
      allow list: if request.auth != null
        && request.auth.uid in resource.data.participantes;
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.participantes;
      allow update: if request.auth != null
        && request.auth.uid in resource.data.participantes;

      match /mensagens/{mensagemId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantes;
        allow create: if request.auth != null
          && request.resource.data.remetenteId == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantes;
      }
    }
  }
}
